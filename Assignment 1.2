import pandas as pd

# Create DataFrame
data = {
    "Student Name": ["Abir", "Rahul", "Priya", "Amit", "Sneha"],
    "Roll Number": [101, 102, 103, 104, 105],
    "Marks": [85, 75, 92, 68, 88],
    "Attendance": [90, 85, 95, 80, 92]
}

df = pd.DataFrame(data)

# Filter students who scored above 80
result = df[df["Marks"] > 80]

# Display result
print(result)
